<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hotel.views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False">

    <VerticalStackLayout VerticalOptions="Center" Padding="10">

    
            <Label Grid.Row="0" Grid.Column="0"
                   Text="Cálculo da Diária"
                   FontFamily="Exile"
                   FontSize="30"
                   TextColor="#CB4154"
                   VerticalOptions="Center" 
                   HorizontalOptions="Center"
                   Margin="0,0,10,0" />


        <Frame Padding="10" BackgroundColor="Black">
            <VerticalStackLayout>
                <Grid RowDefinitions="Auto, Auto"
                      ColumnDefinitions="*, *, 2*"
                      HorizontalOptions="CenterAndExpand">

                    <Label Grid.Row="0"  Grid.Column="0"
                           Text="Adultos: "></Label>

                    <Label Grid.Row="0"  Grid.Column="1"
                           TextColor="#CB4154"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_Adultos}"></Label>

                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stp_Adultos"
                             Minimum="0"
                             Maximum="10"
                             Increment="1">
                    </Stepper>

                    <Label Grid.Row="1"  Grid.Column="0"
                           Text="Crianças: "></Label>

                    <Label Grid.Row="1"  Grid.Column="1"
                            TextColor="#CB4154"
                            Text="{Binding Value}"
                            BindingContext="{x:Reference stp_Criancas}"></Label>

                    <Stepper Grid.Row="1" Grid.Column="2"
                             x:Name="stp_Criancas"
                             Minimum="0"
                             Maximum="10"
                             Increment="1">
                    </Stepper>
                </Grid>

                <Label Text="Escolha uma Suíte" 
                       HorizontalOptions="CenterAndExpand"
                       ></Label>
                <Picker x:Name="pck_Suite"
                        Title="Selecione sua acomodação"
                        ItemDisplayBinding="{Binding Descricao}"
                        HorizontalOptions="CenterAndExpand"></Picker>

                <Frame Padding="10" Margin="0,10,0,10" BackgroundColor="Black">
                    <VerticalStackLayout>
                        <Label Text="Período de Estadia"
                               HorizontalOptions="CenterAndExpand"
                               ></Label>
                        
                        <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                            <Label Text="Check-in: " VerticalOptions="Center"></Label>
                            <DatePicker x:Name="dtpck_checkin"
                                        DateSelected="dtpck_checkin_DateSelected"
                                        Format="dd/MM/yyyy"></DatePicker>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                            <Label Text="Check-out: " VerticalOptions="Center"></Label>
                            <DatePicker x:Name="dtpck_checkout"
                                        Format="dd/MM/yyyy"></DatePicker>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>
                <Button Text="Avançar"
                        BackgroundColor="#CB4154"
                        Clicked="Button_Clicked"></Button>
            </VerticalStackLayout>
        </Frame>
        <Button  Text="SOBRE"
                 TextColor="Black"
                 BackgroundColor="#CB4154"
                 VerticalOptions="End"
                 HorizontalOptions="End"
                 Margin="20"
                 WidthRequest="100"
                 Clicked="Info">
                 
        </Button>
    </VerticalStackLayout>
</ContentPage>
